# TTB Pipeline Environment Configuration
# Copy this file to .env and update values for your environment

# Deployment Environment (dev, staging, prod)
DAGSTER_DEPLOYMENT=dev

# S3 Configuration
TTB_S3_BUCKET=ciq-dagster
TTB_RAW_PREFIX=ttb-pre-prod/ttb_raw_data
TTB_PROCESSED_PREFIX=ttb-pre-prod/ttb_processed_data
TTB_DIMENSIONAL_PREFIX=ttb-pre-prod/ttb_dimensional
TTB_CONSOLIDATED_PREFIX=ttb-pre-prod/ttb_consolidated
TTB_ANALYTICS_PREFIX=ttb-pre-prod/ttb_analytics

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Partition Date Range (last 5 years by default)
TTB_PARTITION_START_DATE=2020-01-01
TTB_PARTITION_END_DATE=2025-12-31

# Processing Configuration
TTB_MAX_SEQUENCE=15000
TTB_EXTRACTION_MAX_SEQUENCE=15000
TTB_CONSECUTIVE_FAILURE_THRESHOLD=500
TTB_REQUEST_DELAY=0.5
TTB_MAX_RETRIES=3
TTB_SSL_VERIFY=false
TTB_ENABLE_GAP_DETECTION=true

# Data Quality Settings
TTB_ENABLE_QUALITY_CHECKS=true
TTB_ENABLE_DEDUP=true
TTB_CREATE_PARTITIONED=true

# Dimensional Modeling Settings
TTB_DATE_START_YEAR=2015
TTB_DATE_END_YEAR=2030
TTB_SURROGATE_KEYS=true

# Development Settings (dev environment only)
TTB_DEBUG_LOGGING=true
TTB_SAMPLE_DATA_ONLY=false